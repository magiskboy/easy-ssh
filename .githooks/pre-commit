# Pre-commit: auto-format staged C++ with clang-format, then REUSE lint.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Prefer project venvs (.venv first — some toolchains live there; then .deps/venv).
_path_prefix=""
for _venv in "${ROOT}/.venv" "${ROOT}/.deps/venv"; do
  if [[ -d "${_venv}/bin" ]]; then
    _path_prefix="${_path_prefix}${_path_prefix:+:}${_venv}/bin"
  elif [[ -d "${_venv}/Scripts" ]]; then
    _path_prefix="${_path_prefix}${_path_prefix:+:}${_venv}/Scripts"
  fi
done
if [[ -n "${_path_prefix}" ]]; then
  export PATH="${_path_prefix}:${PATH}"
fi
unset _path_prefix _venv

FORMAT="${ROOT}/.github/scripts/run-clang-format.sh"
REUSE_LINT="${ROOT}/.github/scripts/run-reuse-lint.sh"

# Staged C/C++ that still exist (added / copied / modified / renamed).
mapfile -t staged_cxx < <(
  git diff --cached --name-only --diff-filter=ACMR -- '*.cpp' '*.h' '*.hpp' \
    | while IFS= read -r f; do
        [[ -f "$f" ]] && printf '%s\n' "$f"
      done
)

if [[ ${#staged_cxx[@]} -gt 0 ]]; then
  echo "pre-commit: clang-format (${#staged_cxx[@]} staged file(s))"
  "$FORMAT" "${staged_cxx[@]}"
  # Re-stage so the commit includes any formatting fixes.
  git add -- "${staged_cxx[@]}"
else
  echo "pre-commit: clang-format skipped (no staged C/C++ files)"
fi

echo "pre-commit: reuse lint"
"$REUSE_LINT"
