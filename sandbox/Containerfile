# Base image for the easy-ssh integration lab (Ubuntu LTS + OpenSSH + helpers).

FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        openssh-server \
        openssh-client \
        python3 \
        curl \
        ca-certificates \
        netcat-openbsd \
        iproute2 \
        procps \
        sudo \
        vim-tiny \
        less \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/run/sshd /etc/ssh/sshd_config.d /opt/lab /run/lab \
    && ssh-keygen -A

COPY scripts/entrypoint.sh /usr/local/bin/lab-entrypoint
COPY scripts/http_tcp.py /opt/lab/http_tcp.py
COPY scripts/http_uds.py /opt/lab/http_uds.py
COPY sshd/ /opt/lab/sshd/
COPY fixtures/lab-keys/ /opt/lab/keys/
COPY fixtures/host-keys/ /opt/lab/host-keys/

RUN chmod +x /usr/local/bin/lab-entrypoint \
    && chmod +x /opt/lab/http_tcp.py /opt/lab/http_uds.py \
    && chmod 644 /opt/lab/keys/authorized_keys /opt/lab/keys/*.pub \
    && chmod 600 /opt/lab/keys/id_ed25519 /opt/lab/keys/id_ed25519_passphrase \
    && find /opt/lab/host-keys -type f -name 'ssh_host_*' ! -name '*.pub' -exec chmod 600 {} + \
    && find /opt/lab/host-keys -type f -name '*.pub' -exec chmod 644 {} +

EXPOSE 22 8080

ENTRYPOINT ["/usr/local/bin/lab-entrypoint"]
