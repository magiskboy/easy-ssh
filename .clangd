CompileFlags:
  CompilationDatabase: build
  Add: [-Wno-unknown-warning-option]

Diagnostics:
  UnusedIncludes: Strict

---
If:
  PathMatch: tests/.*
CompileFlags:
  CompilationDatabase: build-tests

---
If:
  PathMatch: [build/.*, build-tests/.*, \.deps/.*, third_party/.*]
Diagnostics:
  Suppress: ["*"]
Index:
  Background: Skip
