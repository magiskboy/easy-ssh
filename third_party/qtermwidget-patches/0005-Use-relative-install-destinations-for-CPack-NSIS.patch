From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: easy-ssh <dev@easy-ssh>
Date: Wed, 29 Jul 2026 15:53:47 +0000
Subject: [PATCH 5/6] Use relative install destinations for CPack/NSIS

CPack NSIS sets CMAKE_ERROR_ON_ABSOLUTE_INSTALL_DESTINATION, so install()
DESTINATION must be relative (CMAKE_INSTALL_DATADIR), while compile-time
KB_LAYOUT_DIR/COLORSCHEMES_DIR/TRANSLATIONS_DIR keep FULL_* absolute paths.

Co-authored-by: Cursor <cursoragent@cursor.com>

---
 CMakeLists.txt | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9160c2e..a917366 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -129,6 +129,7 @@ set(HDRS_DISTRIB
 )
 
 # dirs
+# FULL_* paths are compiled into the library for system installs.
 set(KB_LAYOUT_DIR "${CMAKE_INSTALL_FULL_DATADIR}/${QTERMWIDGET_LIBRARY_NAME}/kb-layouts")
 message(STATUS "Keyboard layouts will be installed in: ${KB_LAYOUT_DIR}")
 
@@ -138,6 +139,12 @@ message(STATUS "Color schemes will be installed in: ${COLORSCHEMES_DIR}" )
 set(TRANSLATIONS_DIR "${CMAKE_INSTALL_FULL_DATADIR}/${QTERMWIDGET_LIBRARY_NAME}/translations")
 message(STATUS "Translations will be installed in: ${TRANSLATIONS_DIR}")
 
+# Relative destinations are required for CPack generators that forbid absolute
+# INSTALL DESTINATION paths (notably NSIS on Windows).
+set(KB_LAYOUT_INSTALL_DIR "${CMAKE_INSTALL_DATADIR}/${QTERMWIDGET_LIBRARY_NAME}/kb-layouts")
+set(COLORSCHEMES_INSTALL_DIR "${CMAKE_INSTALL_DATADIR}/${QTERMWIDGET_LIBRARY_NAME}/color-schemes")
+set(TRANSLATIONS_INSTALL_DIR "${CMAKE_INSTALL_DATADIR}/${QTERMWIDGET_LIBRARY_NAME}/translations")
+
 set(QTERMWIDGET_INCLUDE_DIR "${CMAKE_INSTALL_FULL_INCLUDEDIR}/${QTERMWIDGET_LIBRARY_NAME}")
 
 CHECK_FUNCTION_EXISTS(updwtmpx HAVE_UPDWTMPX)
@@ -153,7 +160,7 @@ lxqt_translate_ts(QTERMWIDGET_QM
     SOURCES
         ${SRCS} ${HDRS} ${UI}
     INSTALL_DIR
-        ${TRANSLATIONS_DIR}
+        ${TRANSLATIONS_INSTALL_DIR}
     COMPONENT
         Runtime
 )
@@ -269,14 +276,14 @@ install(FILES
 # keyboard layouts
 install(DIRECTORY
     lib/kb-layouts/
-    DESTINATION "${KB_LAYOUT_DIR}"
+    DESTINATION "${KB_LAYOUT_INSTALL_DIR}"
     COMPONENT Runtime
     FILES_MATCHING PATTERN "*.keytab"
 )
 # color schemes
 install(DIRECTORY
     lib/color-schemes/
-    DESTINATION "${COLORSCHEMES_DIR}"
+    DESTINATION "${COLORSCHEMES_INSTALL_DIR}"
     COMPONENT Runtime
     FILES_MATCHING PATTERN "*.*schem*"
 )
