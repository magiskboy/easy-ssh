From: easy-ssh <dev@easy-ssh>
Date: Thu, 30 Jul 2026 06:12:00 +0700
Subject: [PATCH 5/5] Use relative install dirs for CPack/NSIS

Keep CMAKE_INSTALL_FULL_* for compile definitions, but install()
DESTINATION must stay relative so NSIS packaging works.

---
diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9160c2e..16f0eca 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -129,14 +129,18 @@ set(HDRS_DISTRIB
 )
 
 # dirs
+# Absolute paths for compile-time defaults; relative paths for install()/CPack (NSIS forbids absolute DESTINATIONs).
 set(KB_LAYOUT_DIR "${CMAKE_INSTALL_FULL_DATADIR}/${QTERMWIDGET_LIBRARY_NAME}/kb-layouts")
-message(STATUS "Keyboard layouts will be installed in: ${KB_LAYOUT_DIR}")
+set(KB_LAYOUT_INSTALL_DIR "${CMAKE_INSTALL_DATADIR}/${QTERMWIDGET_LIBRARY_NAME}/kb-layouts")
+message(STATUS "Keyboard layouts will be installed in: ${KB_LAYOUT_INSTALL_DIR}")
 
 set(COLORSCHEMES_DIR "${CMAKE_INSTALL_FULL_DATADIR}/${QTERMWIDGET_LIBRARY_NAME}/color-schemes")
-message(STATUS "Color schemes will be installed in: ${COLORSCHEMES_DIR}" )
+set(COLORSCHEMES_INSTALL_DIR "${CMAKE_INSTALL_DATADIR}/${QTERMWIDGET_LIBRARY_NAME}/color-schemes")
+message(STATUS "Color schemes will be installed in: ${COLORSCHEMES_INSTALL_DIR}" )
 
 set(TRANSLATIONS_DIR "${CMAKE_INSTALL_FULL_DATADIR}/${QTERMWIDGET_LIBRARY_NAME}/translations")
-message(STATUS "Translations will be installed in: ${TRANSLATIONS_DIR}")
+set(TRANSLATIONS_INSTALL_DIR "${CMAKE_INSTALL_DATADIR}/${QTERMWIDGET_LIBRARY_NAME}/translations")
+message(STATUS "Translations will be installed in: ${TRANSLATIONS_INSTALL_DIR}")
 
 set(QTERMWIDGET_INCLUDE_DIR "${CMAKE_INSTALL_FULL_INCLUDEDIR}/${QTERMWIDGET_LIBRARY_NAME}")
 
@@ -153,7 +157,7 @@ lxqt_translate_ts(QTERMWIDGET_QM
     SOURCES
         ${SRCS} ${HDRS} ${UI}
     INSTALL_DIR
-        ${TRANSLATIONS_DIR}
+        ${TRANSLATIONS_INSTALL_DIR}
     COMPONENT
         Runtime
 )
@@ -269,14 +273,14 @@ install(FILES
 # keyboard layouts
 install(DIRECTORY
     lib/kb-layouts/
-    DESTINATION "${KB_LAYOUT_DIR}"
+    DESTINATION "${KB_LAYOUT_INSTALL_DIR}"
     COMPONENT Runtime
     FILES_MATCHING PATTERN "*.keytab"
 )
 # color schemes
 install(DIRECTORY
     lib/color-schemes/
-    DESTINATION "${COLORSCHEMES_DIR}"
+    DESTINATION "${COLORSCHEMES_INSTALL_DIR}"
     COMPONENT Runtime
     FILES_MATCHING PATTERN "*.*schem*"
 )
