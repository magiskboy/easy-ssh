{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev-system",
      "displayName": "Debug (system packages)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "EASY_SSH_USE_SYSTEM_PACKAGES": "ON",
        "EASY_SSH_FETCH_QT": "OFF",
        "EASY_SSH_BUNDLE_RUNTIME": "OFF",
        "EASY_SSH_INTEGRATION_TESTS": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release (system packages)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "EASY_SSH_USE_SYSTEM_PACKAGES": "ON",
        "EASY_SSH_FETCH_QT": "OFF",
        "EASY_SSH_BUNDLE_RUNTIME": "OFF",
        "EASY_SSH_INTEGRATION_TESTS": "OFF"
      }
    },
    {
      "name": "ci-release",
      "displayName": "Release (FetchContent + aqt Qt)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "EASY_SSH_USE_SYSTEM_PACKAGES": "OFF",
        "EASY_SSH_FETCH_QT": "ON",
        "EASY_SSH_BUNDLE_RUNTIME": "ON",
        "EASY_SSH_INTEGRATION_TESTS": "OFF"
      }
    },
    {
      "name": "integration",
      "displayName": "Debug + integration tests",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-integration",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "EASY_SSH_USE_SYSTEM_PACKAGES": "ON",
        "EASY_SSH_FETCH_QT": "OFF",
        "EASY_SSH_BUNDLE_RUNTIME": "OFF",
        "EASY_SSH_INTEGRATION_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-system",
      "configurePreset": "dev-system"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-release"
    },
    {
      "name": "integration",
      "configurePreset": "integration"
    }
  ]
}
