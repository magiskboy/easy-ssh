.venv

# Build trees (CMake presets: build, build-release, …)
/build/
/build-*/
/cmake-build-*/
/out/

# CPack / local install staging
/dist/
/staging/

# FetchContent (_deps inside build-*) and aqtinstall (Qt cache, CI tools)
/.deps/
aqtinstall.log

# CMake export (generated in build dirs; also ignore stray copy at repo root)
compile_commands.json

# Editor / IDE
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
/.cache/
*.user
*.user.*
CMakeLists.txt.user

# Objects / binaries
*.o
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.app

# CPack artifacts (when cpack is run outside dist/)
*.deb
*.rpm
*.AppImage
*.dmg

# OS
.DS_Store
Thumbs.db
